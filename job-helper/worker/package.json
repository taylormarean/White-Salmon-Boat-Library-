{
  "name": "next-chapter-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node -e \"require('fs').mkdirSync('../frontend/dist',{recursive:true})\" && wrangler dev",
    "deploy": "npm --prefix ../frontend run build && wrangler deploy",
    "db:init": "wrangler d1 execute next-chapter-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute next-chapter-db --remote --file=schema.sql --yes",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "docx": "^9.15.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
